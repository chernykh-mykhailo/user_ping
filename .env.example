# API Credentials (my.telegram.org)
API_ID=your_api_id
API_HASH=your_api_hash
SESSION_NAME=account_session

# Bot Tokens (@BotFather)
PROD_BOT_TOKEN=your_prod_token
TEST_BOT_TOKEN=your_test_token

# Payments
PROD_PAYMENT_TOKEN=your_prod_payment_token
TEST_PAYMENT_TOKEN=your_test_payment_token

# Admin
ADMIN_USER_ID=your_admin_id

# Deployment
BOT_MODE=test  # or prod
